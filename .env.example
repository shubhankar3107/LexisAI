# Application
APP_NAME=LexisAI
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/lexisai

# Embedding
HUGGINGFACE_API_KEY=your_huggingface_token
HUGGINGFACE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
HUGGINGFACE_PROVIDER=hf-inference

# File Storage

UPLOAD_DIRECTORY=uploads
